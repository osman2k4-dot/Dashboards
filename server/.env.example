# ---- Microsoft Entra app registration (application permissions, client credentials) ----
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=paste-the-secret-value-here

# ---- Where the workbook lives on SharePoint ----
# Site: https://contoso.sharepoint.com/sites/ProjectControls
SITE_HOSTNAME=contoso.sharepoint.com
SITE_PATH=/sites/ProjectControls
# Path of the file inside the site's default document library ("Documents" / "Shared Documents")
FILE_PATH=Daily Progress/U400-progress-diary.xlsx

# ---- App access ----
# Planners paste this key into the app (Setup > SharePoint sync). Leave empty to allow anyone who can reach the server.
APP_KEY=change-me-to-a-long-random-string
# Where the web app is served from, for CORS. Use * while testing.
ALLOWED_ORIGIN=*
PORT=8080

# ---- Daily diary automation (optional) ----
# Local time (TZ below) at which the server writes the Daily Diary sheet for today and emails it.
DIARY_CUTOFF=18:30
TZ=Asia/Riyadh
# Email needs the Mail.Send application permission. Leave MAIL_TO empty to skip email.
MAIL_FROM=projectcontrols@contoso.com
MAIL_TO=construction.manager@contoso.com, client.rep@example.com
